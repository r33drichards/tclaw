OPENAI_API_KEY=sk-...
TEMPORAL_ADDRESS=localhost:7233
TEMPORAL_NAMESPACE=default
TASK_QUEUE=chat
WEBHOOK_PORT=8787

# Postgres
DATABASE_URL=postgres://localhost:5432/chat

# Redis
